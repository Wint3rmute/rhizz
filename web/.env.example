# Build-time configuration for the web app. Copy to `.env` (git-ignored) and
# fill in; every value is optional and an empty one simply disables the
# feature. Vite only exposes `VITE_`-prefixed variables to the app bundle —
# see https://vite.dev/guide/env-and-mode
#
# Sentry error reporting (web/src/hooks.client.ts). The DSN is a public
# client key, not a secret, but it identifies your project to Sentry and is
# per-environment, so it is set per build rather than committed. The image
# build takes it as a build arg — see the Dockerfile.
VITE_SENTRY_DSN=

# Source-map upload for readable production stack traces (web/vite.config.ts).
# Build-time only — never shipped to the browser. Needs `org:project` write
# access. With no token the build emits no source maps at all.
#
# Create one at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Where the VFS persistence API lives. Baked into the image as "/" so the
# embedded frontend talks to its own origin's /api/vfs.
VITE_RHIZZ_SERVER_URL=
