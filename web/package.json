{
  "name": "rhizz-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "build-storybook": "storybook build --config-dir .storybook --output-dir storybook-static",
    "lint": "svelte-kit sync && eslint .",
    "chromatic": "npx chromatic --exit-once-uploaded"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@storybook/addon-themes": "10.5.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.3",
    "d3-force": "^3.0.0",
    "daisyui": "^5.7.7",
    "marked": "^14.0.0",
    "rhizz": "file:../crates/rhizz-wasm/pkg/",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/svelte": "^10.5.5",
    "@storybook/sveltekit": "^10.5.5",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "chromatic": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "monaco-editor": "^0.55.1",
    "playwright": "1.61.1",
    "storybook": "^10.5.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
