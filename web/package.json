{
  "name": "rhizz-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "build-storybook": "storybook build --config-dir .storybook --output-dir storybook-static",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "d3-force": "^3.0.0",
    "daisyui": "^5.6.18",
    "rhizz": "file:../crates/rhizz-wasm/pkg/",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/svelte": "^10.5.5",
    "@storybook/sveltekit": "^10.5.5",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24",
    "chromatic": "^18.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "monaco-editor": "^0.55.1",
    "storybook": "^10.5.5",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
