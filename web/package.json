{
  "name": "rhizz-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "check-only": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "sync": "svelte-kit sync",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build-storybook": "svelte-kit sync && storybook build --config-dir .storybook --output-dir storybook-static",
    "lint": "svelte-kit sync && eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "eslint": "eslint . --cache --cache-location .eslintcache --cache-strategy content"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sentry/sveltekit": "^11.1.0",
    "@storybook/addon-themes": "10.5.5",
    "@sveltejs/adapter-static": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.3",
    "@zag-js/svelte": "^1.44.0",
    "@zag-js/tour": "^1.44.0",
    "d3-force": "^3.0.0",
    "daisyui": "^5.7.7",
    "fuse.js": "^7.1.0",
    "marked": "^14.0.0",
    "rhizz": "file:../crates/rhizz-wasm/pkg/",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/svelte": "^10.5.5",
    "@storybook/sveltekit": "^10.5.5",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "monaco-editor": "^0.55.1",
    "playwright": "1.63.0",
    "storybook": "^10.5.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  }
}
