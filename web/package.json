{
  "name": "rhizz-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "check-only": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y_click_events_have_key_events:ignore",
    "sync": "svelte-kit sync",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:vrt": "playwright test -c playwright.vrt.config.ts",
    "test:vrt:accept": "playwright test -c playwright.vrt.config.ts --update-snapshots=all",
    "storybook": "storybook dev --config-dir .storybook",
    "build-storybook": "svelte-kit sync && storybook build --config-dir .storybook --output-dir storybook-static",
    "lint": "svelte-kit sync && eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "eslint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sentry/sveltekit": "^11.1.0",
    "@storybook/addon-themes": "^10.6.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@zag-js/svelte": "^1.44.0",
    "@zag-js/tour": "^1.44.0",
    "d3-force": "^3.0.0",
    "daisyui": "^5.7.21",
    "fuse.js": "^7.5.0",
    "marked": "^14.0.0",
    "rhizz": "file:../crates/rhizz-wasm/pkg/",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/svelte": "^10.6.2",
    "@storybook/sveltekit": "^10.6.2",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "storybook": "^10.6.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  }
}
