/target
/out
/book/target-mdbook
.vscode


# macos temporaries
.DS_Store

# Local build-time config: holds the Sentry auth token (web/.env.example
# documents the variables). Mirrors .dockerignore, so it covers the repo
# root too — an unanchored pattern matches at any depth.
.env
.env.*
!.env.example

# Nix build outputs (`nix build .#<package>`)
/result
/result-*

# Python bytecode (book preprocessor + tests)
__pycache__/

# Artifacts the playwright MCP server drops wherever it happens to be run
# from (page snapshots + console logs), which is the repo root when an agent
# drives it from here.
.playwright-mcp/

# rhizz-server's default data dir, for a local run without RHIZZ_DATA_DIR
# (see `just serve` for the examples/ one).
rhizz-data/
