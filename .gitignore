# LLMs sometimes create this when running under copilot, ignore.
# Only Deno-based dependencies.
web/package-lock.json

# macos temporaries
.DS_Store

# Local build-time config: holds the Sentry auth token (web/.env.example
# documents the variables). Mirrors .dockerignore, so it covers the repo
# root too — an unanchored pattern matches at any depth.
.env
.env.*
!.env.example

# Python bytecode (book preprocessor + tests)
__pycache__/
